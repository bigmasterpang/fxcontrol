[Unit]
Description=FX Manager Multi-User Device Service
After=network.target mosquitto.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/fx-manager
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=5
Environment=HOST=127.0.0.1
Environment=PORT=8089
Environment=TZ=Asia/Shanghai
Environment=DB_PATH=/var/www/fx-manager/fx.db

[Install]
WantedBy=multi-user.target
