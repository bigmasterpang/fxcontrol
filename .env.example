# FXControl Configuration

# Server
HOST=0.0.0.0
PORT=8089
JWT_SECRET=replace_with_a_long_random_secret_string

# MQTT Broker (Used by backend to publish controls & listen to telemetry)
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# MQTT Device & Public Connection Settings
# Configures the parameters shown in the login page platform guide.
# If MQTT_PUBLIC_HOST is left empty, the web UI dynamically detects and uses the browser's current host (IP or domain).
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=1883
MQTT_USER=master
MQTT_PASS=apple123

# SQLite Database path
DB_PATH=data/fx.db

# Default Admin User (initialized on first run if no admin exists)
FX_ADMIN_USER=admin
FX_ADMIN_PASS=admin123
